# ========================
# BASE DE DATOS
# ========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticketera_rn
DB_USER=ticketera_user
DB_PASSWORD=ticketera123

# ========================
# SERVIDOR
# ========================
PORT=3001
NODE_ENV=development

# ========================
# JWT
# ========================
# Generá una clave segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiar_por_clave_segura_generada
JWT_EXPIRES_IN=7d

# ========================
# EMAIL (Gmail)
# ========================
# Usá una "contraseña de aplicación" de Gmail, no tu contraseña normal
# Ver: https://support.google.com/accounts/answer/185833
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=contraseña_de_aplicacion_gmail
EMAIL_FROM=TicketeraRN <tu_email@gmail.com>

# ========================
# FRONTEND
# ========================
FRONTEND_URL=http://localhost:5173
